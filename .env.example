# テトックス サーバ設定
# ローカルは .env にコピー。本番は Railway の Variables で設定する。

PORT=3001
CORS_ORIGIN=*

# --- セッション ---------------------------------------------------------
# セッション Cookie の暗号化鍵。長いランダム文字列にする。
#   openssl rand -hex 32
# 未設定だと起動ごとにランダムな鍵になり、再デプロイのたびに全員
# ログアウトする。本番では必ず設定すること。
SESSION_SECRET=

# ローカル開発（http://localhost）でだけ 1 にする。
# Cookie の Secure 属性を外すため、HTTPS でない環境でログインできる。
# 本番では設定しないこと。
# COOKIE_INSECURE=1

# --- テクマナ連携（任意）------------------------------------------------
# 未設定ならこの機能は「無効」と報告されるだけで、ゲームは通常どおり動く。
#
# テクマナの管理画面 /admin/apps に登録した値と揃える。
# リダイレクトURIは完全一致で照合されるので 1 バイトも違えてはいけない。
#
#   クライアントID  tetox
#   アプリ名        テトックス
#   リダイレクトURI https://<このサーバ>/api/auth/techmana/callback
#   許可オリジン    (空のまま。サーバ間通信なので CORS 不要)
#   スコープ        profile save
#   公開アプリ      チェックしない（シークレットを持つ機密クライアント）
#
TECHMANA_BASE_URL=https://techmana.adamant-group.jp
TECHMANA_CLIENT_ID=
TECHMANA_CLIENT_SECRET=
TECHMANA_REDIRECT_URI=

# 認可の往復から戻ってきたブラウザの行き先。
# クライアントはこのサーバ自身が配信しているので、既定の相対パスでよい。
CLIENT_BASE_URL=/
